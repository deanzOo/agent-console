{
  "config": {
    "default": true,
    // Prettier owns wrapping; two tools fighting over it helps nobody.
    "MD013": false,
    // Repeated headings are correct in ADRs, where every record has the same shape.
    "MD024": { "siblings_only": true },
    "MD033": { "allowed_elements": ["br"] },
  },
  "globs": ["**/*.md"],
  // Build output now lives per package, so these are matched at any depth.
  "ignores": [
    "**/node_modules",
    "**/.next",
    "**/coverage",
    "**/dist",
    "graphify-out",
    "CHANGELOG.md",
    "drizzle",
  ],
}
