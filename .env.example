# ─── Agent Console configuration ────────────────────────────────────────────
#
# Copy to `.env` and fill in. Every key is documented here — this file is the
# contract. Anything left blank is treated as unset, and the feature that needs
# it is hidden rather than broken.
#
# Values can also be set later from the /setup wizard, which stores them in the
# database. Env vars win over stored settings.
#
# Only AUTH_MODE (and its dependencies) plus an Anthropic credential are needed
# to start. Everything else is optional.

# ─── Authentication ─────────────────────────────────────────────────────────
# How the app decides who you are. Pick one:
#
#   cloudflare-access  Verifies Cloudflare Access's signed JWT. Recommended:
#                      no inbound ports, free TLS, SSO on your phone.
#   password           A single password you set during /setup. Use behind your
#                      own domain + reverse proxy with TLS.
#   trusted-network    No authentication at all. Only for a private tailnet or
#                      WireGuard. Refuses to start on a public bind unless
#                      ALLOW_INSECURE=1.
#
AUTH_MODE=cloudflare-access

# Required when AUTH_MODE=cloudflare-access.
# Team domain: Cloudflare Zero Trust → Settings → Custom Pages (the
# <team>.cloudflareaccess.com hostname).
CF_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) tag: Zero Trust → Access → Applications → your app.
CF_ACCESS_AUD=

# ─── Network ────────────────────────────────────────────────────────────────
# Bind address. Keep this on loopback and let cloudflared or your reverse proxy
# reach it. Binding publicly with AUTH_MODE=trusted-network is refused.
HOST=127.0.0.1
PORT=3000

# Docker only: which host port to publish on. Change it when something else
# already holds 3000 on this machine. Ignored outside Docker — use PORT there.
HOST_PORT=3000

# Set to 1 only to acknowledge deliberately exposing an unauthenticated
# instance. Leave blank in every normal deployment.
ALLOW_INSECURE=

# ─── Storage ────────────────────────────────────────────────────────────────
# Database and internal state. Defaults to ~/.claudevps
# The SQLite file holds credentials — it is created with mode 600.
DATA_DIR=

# Where repos are cloned and per-mission worktrees are created.
# Defaults to <DATA_DIR>/work. Point it at a bigger disk if you clone large
# repos; it grows with one worktree per active mission.
WORKSPACE_ROOT=

# ─── Host telemetry ─────────────────────────────────────────────────────────
# Where /proc lives, for the CPU load, memory, network and disk numbers on the
# dashboard. Defaults to /proc, which is right for a bare-metal or systemd
# install — this process's /proc already is the host's there.
#
# Docker only: by default the container has its own network and disk
# counters, not the host's. Bind-mount the host's /proc somewhere else in the
# container (e.g. `/proc:/host/proc:ro` in docker-compose.yml) and point this
# at it to see the real box instead.
HOST_PROC_PATH=

# ─── Anthropic ──────────────────────────────────────────────────────────────
# Agents run through the `claude` CLI, which this app spawns as a child process.
# That CLI needs to be authenticated. Pick ONE:
#
# 1. Your Claude subscription (recommended — no per-token API billing).
#    On any machine where you are already logged in, run:
#        claude setup-token
#    It prints a long-lived token. Paste it here:
CLAUDE_CODE_OAUTH_TOKEN=
#
# 2. An API key, billed per token:
ANTHROPIC_API_KEY=
#
# 3. Neither — if the `claude` CLI on this host is already logged in, its stored
#    login is used and you can leave both blank. This does NOT carry into Docker
#    unless you also mount the CLI's config directory; prefer option 1 there.

# Which `claude` binary to spawn. Leave blank and the SDK picks its own bundled
# one — which is linked against a particular libc and fails to launch when that
# does not match the host, taking every mission down at the moment it starts.
# The Docker image sets this to the CLI it installed. Set it yourself if you
# installed the CLI somewhere non-standard, or hit that mismatch: `which claude`.
CLAUDE_CLI_PATH=

# Where the SQL migrations live. Defaults to ./drizzle beside the working
# directory, which is right when you run from the repository root. The Docker
# image sets it explicitly, because the server starts from the web package's
# own directory and would otherwise find nothing.
MIGRATIONS_DIR=

# The session host listens here, on loopback only. It owns live agent runs, so
# restarting the console does not kill them. Change it only if 3100 is taken.
AGENTD_PORT=

# ─── GitHub (optional) ──────────────────────────────────────────────────────
# Enables the issues panel and lets agents push branches and open PRs.
# Fine-grained PAT with: Contents (read/write), Issues (read/write),
# Pull requests (read/write) on the repos you want to work on.
# Without it, the issues panel is hidden.
# Agents are given this token in their environment so git and gh can
# authenticate. An agent has a shell, so anything it runs can read it: scope the
# token to the repositories you are willing to have an agent write to.
GITHUB_TOKEN=

# ─── Asana (optional) ───────────────────────────────────────────────────────
# Enables the tasks panel. Personal access token from
# Asana → Settings → Apps → Developer apps → Personal access tokens.
# Without it, the tasks panel is hidden.
ASANA_TOKEN=

# ─── Web push (optional) ────────────────────────────────────────────────────
# Notifies you when an agent is blocked waiting on an answer.
# Generate a keypair with: npx web-push generate-vapid-keys
# Both keys are required; with neither, the push prompt is hidden.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address Cloudflare/push services use to reach you about your keys.
VAPID_SUBJECT=

# ─── Telegram (optional) ────────────────────────────────────────────────────
# A more reliable fallback than web push, especially on iOS.
# Create a bot with @BotFather, then message it once and read your chat id from
# https://api.telegram.org/bot<token>/getUpdates
# Both values are required.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Sessions (AUTH_MODE=password only) ─────────────────────────────────────
# Signs the session cookie. Required for password mode and nothing else.
# Middleware runs before the database is reachable, so unlike other secrets
# this one cannot be filled in from /setup.
# Generate with: openssl rand -hex 32
SESSION_SECRET=
