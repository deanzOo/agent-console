# Local config and data — never committed
.env
.env.local
data.db
data.db-journal
data.db-wal
data.db-shm

.DS_Store

# Build output. agentd is bundled at build time, not committed.
dist/

# Deployment target. scripts/deploy.sh is generic; this names your server.
.deploy.env

# Stryker writes its sandboxes and reports here; both are local artifacts.
.stryker-tmp/
reports/

# Turborepo's local task cache — a build artifact, never committed.
.turbo/

# Deployment-specific compose changes. A deploy resets the checkout, so an edit
# to docker-compose.yml on a server does not survive one - this does.
docker-compose.override.yml
