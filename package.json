{
  "name": "claudevps",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "description": "Self-hosted control panel for Claude Code agents running on your own VPS",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "npm run dev   -w @agent-console/web",
    "build": "turbo run build",
    "start": "npm run start -w @agent-console/web",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck typecheck:root",
    "typecheck:root": "tsc --noEmit",
    "dupes": "jscpd",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "graph": "GRAPHIFY_FORCE=1 graphify update .",
    "graph:update": "graphify update .",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "lint:md": "markdownlint-cli2",
    "lint:links": "git ls-files '*.md' | xargs -n1 markdown-link-check --quiet --config .markdown-link-check.json",
    "ci": "bash scripts/ci-local.sh",
    "mutation": "stryker run"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@agent-console/core": "*",
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "jose": "^6.2.7",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.39.5",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "jscpd": "^5.0.14",
    "lint-staged": "^17.3.0",
    "markdown-link-check": "^3.15.0",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.10.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "minimatch": "^10.2.6",
    "postcss": "^8.5.25",
    "sharp": "^0.35.3",
    "esbuild": "^0.25.12",
    "fast-uri": "^4.1.2",
    "qs": "^6.15.2"
  }
}
