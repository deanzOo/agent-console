{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "typecheck": {
      "dependsOn": ["topo"]
    },
    "//#typecheck:root": {
      "inputs": ["scripts/**/*.ts", "*.ts", "tsconfig.json"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    }
  }
}
